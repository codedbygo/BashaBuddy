# All optional. No API keys are needed.
# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel preview deployments.
# ALLOWED_ORIGIN_REGEX=https://bhashabuddy-.*\.vercel\.app

# Speech-to-text (Faster-Whisper). Set WHISPER_ENABLED=false on hosts with too little memory.
WHISPER_ENABLED=true
# tiny | base | small | medium. "small" is much better for Telugu and Hindi but needs about 1 GB RAM.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_MB=10
